{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Run by hand or by agents, never imported. Globbed rather than listed, so
  // a repo that merges this one can add scripts and skills of its own without
  // editing this file. The worker imports a site's own jobs from
  // src/jobs/extensions/ by listing the folder, so nothing imports them by
  // name either (src/jobs/registry.ts). They share a pattern with scripts
  // because that folder holds none here, and a pattern of its own matching
  // nothing would print a knip hint on every run.
  "entry": [
    "{scripts/**/*.{ts,mjs},src/jobs/extensions/*.jobs.ts}",
    ".claude/skills/**/*.{js,mjs,ts}",
  ],
  "ignore": [
    // A design reference kit, not part of the app.
    "design-system/**",
    // The catalogs' types, written by next-intl's plugin (next.config.mjs).
    // TypeScript reads one in place of its .json file's own types
    // (allowArbitraryExtensions), so nothing imports it by name.
    "src/messages/*.d.json.ts",
  ],
  "ignoreDependencies": [
    // Loaded by name: eslint.config.mjs extends next/core-web-vitals, and
    // src/lib/log.ts names pino-pretty as a transport target.
    "eslint-config-next",
    "pino-pretty",
  ],
}
