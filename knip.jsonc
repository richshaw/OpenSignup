{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Run by hand or by agents, never imported. Globbed rather than listed, so
  // a repo that merges this one can add scripts and skills of its own without
  // editing this file.
  "entry": ["scripts/**/*.{ts,mjs}", ".claude/skills/**/*.{js,mjs,ts}"],
  // A design reference kit, not part of the app.
  "ignore": ["design-system/**"],
  "ignoreDependencies": [
    // Loaded by name: eslint.config.mjs extends next/core-web-vitals, and
    // src/lib/log.ts names pino-pretty as a transport target.
    "eslint-config-next",
    "pino-pretty",
    // knip assumes `email dev` needs it; react-email 3 ships its own.
    "@react-email/preview-server",
  ],
}
